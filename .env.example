# ─────────────────────────────────────────────────────────────
# Doctor Tracker web app — environment template
# Copy to .env (never committed) and adjust if the ports change.
# ─────────────────────────────────────────────────────────────

# Browser-visible base URL of the Express API.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Server-side base URL used by Next.js Server Components to reach the API while
# forwarding the session cookies. Keep this on the loopback interface.
API_SERVER_URL=http://localhost:5000/api/v1
